;; Karabiner-Elements config, compiled to ~/.config/karabiner/karabiner.json by goku.
;; Run `goku` after editing, or `brew services start goku` to watch this file.
;; Reference: https://github.com/yqrashawn/GokuRakuJoudo/blob/master/tutorial.md
;;
;; `:##key` means {:key_code "key" :modifiers {:optional ["any"]}}, which is what
;; modifier-to-modifier remaps need so other held modifiers pass through.
;;
;; NOTE: karabiner does NOT feed a manipulator's output back into other
;; manipulators, so every physical key must state its final output in one rule.
;; That is why caps_lock maps straight to left_command instead of relying on the
;; global ctrl->cmd swap below.

{;; The applications that should NOT receive the global cmd/ctrl swap.
 ;; The bundle identifier remains com.microsoft.rdc.macos, despite Microsoft rebranding it from Microsoft Remote Desktop to Windows App.
 :applications {:exceptions ["^com\\.googlecode\\.iterm2$"
                             "^com\\.mitchellh\\.ghostty$"
                             "^com\\.microsoft\\.rdc\\.macos$"]}

 ;; The only place the built-in keyboard is described.
 :devices {:builtin [{:is_built_in_keyboard true}]}

 :main
 [{:des "Built-in keyboard: caps lock acts as ctrl, ctrl acts as caps lock"
   :rules [;; caps lock behaves as ctrl, so it sends cmd wherever ctrl is swapped
           [:##caps_lock :left_command [:builtin :!exceptions]]
           [:##caps_lock :left_control [:builtin :exceptions]]
           ;; the physical ctrl key takes over caps lock, in every app
           [:##left_control :caps_lock [:builtin]]]}

  {:des "Swap cmd and ctrl everywhere except iTerm2, Ghostty, and Windows App"
   :rules [[:##left_command :left_control [:!exceptions]]
           ;; built-in ctrl is already caps lock above, so exclude it here
           [:##left_control :left_command [:!exceptions :!builtin]]
           [:##right_command :right_control [:!exceptions]]
           [:##right_control :right_command [:!exceptions]]]}]}
